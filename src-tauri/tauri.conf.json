{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vox",
  "version": "0.1.2",
  "identifier": "com.vox.voice",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vox",
        "width": 720,
        "height": 680,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/whisper"],
    "resources": ["resources/models/*"],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
